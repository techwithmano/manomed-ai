# Google GenAI API Key (Required for AI medical reasoning - Free tier from Google AI Studio)
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here

# Clerk Authentication (Optional / Configurable from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# SendGrid Email Delivery (Optional - for sending patient clinical PDF summaries via email)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDER_EMAIL=your_verified_sender@domain.com
RECIPIENT_EMAIL=reports@yourdomain.com

# Cloud Synchronization (Optional - default is false, records stay on this device)
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false

# Firebase Configuration (Required only if NEXT_PUBLIC_ENABLE_CLOUD_SYNC=true)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

